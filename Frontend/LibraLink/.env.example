# Base URL of the LibraLink Spring Boot API this app talks to.
# Leave unset (or don't create .env.local) to use the deployed production
# backend - that's the default hardcoded in src/config/api.ts.
#
# For local development, copy this file to .env.local and uncomment the ONE
# line matching whichever device you're running on - only one at a time:

# iOS Simulator - shares your Mac's network, localhost works directly.
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# Android emulator - 10.0.2.2 is the emulator's alias for your Mac's localhost.
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080

# Physical device via Expo Go - must be on the same Wi-Fi as your Mac.
# Find your Mac's LAN IP with: ipconfig getifaddr en0
# EXPO_PUBLIC_API_BASE_URL=http://192.168.x.x:8080
