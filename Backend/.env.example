# Copy this file to `.env` (or otherwise inject these as real environment
# variables) and fill in real values. Never commit an actual `.env` file.

# --- Server ---
# The Expo app's local API URL (Frontend/LibraLink/src/config/api.ts) points at
# http://localhost:8080 to match this default. If you change PORT here, update api.ts too.
PORT=8080

# --- Database (required, no defaults) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/libralink
SPRING_DATASOURCE_USERNAME=libralink
SPRING_DATASOURCE_PASSWORD=change-me

# --- Auth (required, no default) ---
# Use a long, random, high-entropy secret in every real environment.
JWT_SECRET=change-me-to-a-long-random-secret

# --- Admin seed account ---
# Created on first startup if no user with this email exists yet.
# ALWAYS override SEED_ADMIN_PASSWORD outside of local development.
SEED_ADMIN_EMAIL=admin@libralink.com
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=User

# --- Pickup scheduling ---
# Length of a book-pickup window in minutes. Pickups are only accepted Monday–Friday,
# 09:00–17:00, and the whole window must fit inside those hours (so a 30-min window
# means the latest start is 4:30 PM).
PICKUP_WINDOW_MINUTES=30

# --- Expo push notifications ---
# Set to true to actually deliver pushes via Expo. Requires each user's device to have
# registered a push token (the app does this after login). Apple push does NOT work on
# the iOS Simulator — verify real delivery on a physical device.
EXPO_PUSH_ENABLED=false

# --- Brevo (transactional email API) ---
# Used for BOTH password-reset codes and student self-registration email-verification
# codes - a plain HTTPS call, no SMTP. Get an API key from Brevo -> Settings -> SMTP & API
# -> API Keys, and verify BREVO_SENDER_EMAIL as a sender under Senders, Domains &
# Dedicated IPs -> Senders (Brevo rejects sends from an unverified address). If
# BREVO_API_KEY is left blank, codes are logged to the server console instead (dev
# fallback) rather than emailed.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@libralink.com
BREVO_SENDER_NAME=LibraLink
EMAIL_VERIFICATION_EXPIRY_MINUTES=15

# --- Paystack payments (fine payments) ---
# TEST keys only for dev/demo — no real money moves. Get them from the Paystack
# dashboard: Settings -> API Keys & Webhooks (in Test Mode).
#   PAYSTACK_SECRET_KEY  -> sk_test_...  (backend only, never ship to the app)
#   PAYSTACK_PUBLIC_KEY  -> pk_test_...  (safe to expose to the app)
# If the secret key is blank, the payment endpoints return 503 and the fine stays unpaid.
# Amounts are charged in GHS (converted to pesewas server-side). Test card: 4084 0840
# 8408 4081, any future expiry, any CVV.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CURRENCY=GHS

# --- Text-to-speech (Google AI Studio / Gemini) ---
# Reuses AI_API_KEY and AI_API_URL below (no separate key). Gemini returns raw PCM which the
# backend wraps as WAV. Override the model/voice if you like (voices: Kore, Puck, Charon, ...).
TTS_MODEL=gemini-2.5-flash-preview-tts
TTS_VOICE=Kore

# --- AI / Google AI Studio (Gemini) API ---
# Powers Ask Libra (grounded chat) and exam summaries/questions. Get a key at
# https://aistudio.google.com/apikey. If AI_API_KEY is blank, Ask Libra falls back to
# canned answers and exam generation is disabled. AI_API_URL is the API base (LlmClient
# appends /models/{model}:generateContent); AI_MODEL is any AI Studio model id.
AI_API_URL=https://generativelanguage.googleapis.com/v1beta
AI_API_KEY=
AI_MODEL=gemini-flash-latest
