		{
			"name": "Book Copies",
			"item": [
				{ "name": "Create Book Copy (Librarian)",
					"event": [{ "listen": "test", "script": { "exec": [
						"pm.test('Status is 200', function () { pm.expect(pm.response.code).to.equal(200); });",
						"var j = pm.response.json();",
						"if (j.barcode) { pm.collectionVariables.set('testBarcode', j.barcode); }",
						"if (j.id) { pm.collectionVariables.set('testBookCopyId', String(j.id)); }"
					]}}],
					"request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{librarianToken}}" }],
					"body": { "mode": "raw", "raw": "{\n  \"book\": {\"id\": {{testBookId}}},\n  \"barcode\": \"\",\n  \"condition\": \"NEW\",\n  \"notes\": \"\"\n}" },
					"url": { "raw": "{{baseUrl}}/api/book-copies", "host": ["{{baseUrl}}"], "path": ["api", "book-copies"] }
				}},
				{ "name": "Get All Book Copies (Librarian)", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{librarianToken}}" }], "url": { "raw": "{{baseUrl}}/api/book-copies", "host": ["{{baseUrl}}"], "path": ["api", "book-copies"] } } },
				{ "name": "Lookup Copy by Barcode",
					"event": [
						{ "listen": "prerequest", "script": { "exec": [
							"const token = pm.collectionVariables.get('librarianToken');",
							"const barcode = pm.collectionVariables.get('testBarcode');",
							"if (!token) { throw new Error('librarianToken is empty. Run Auth > Login - Librarian first.'); }",
							"if (!barcode) { throw new Error('testBarcode is empty. Run Create Book Copy first, or set testBarcode manually.'); }",
							"console.log('Lookup using barcode=', barcode, 'tokenLength=', token.length);"
						]}},
						{ "listen": "test", "script": { "exec": [
							"pm.test('Status is 200', function () { pm.expect(pm.response.code).to.equal(200); });",
							"pm.test('Barcode matches', function () { pm.expect(pm.response.json().barcode).to.eql(pm.collectionVariables.get('testBarcode')); });"
						]}}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{librarianToken}}", "type": "string" }]
						},
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/api/book-copies/barcode/{{testBarcode}}", "host": ["{{baseUrl}}"], "path": ["api", "book-copies", "barcode", "{{testBarcode}}"] }
					}
				}
			]
		},
