						"pm.test('Status is 200', function () { pm.expect(pm.response.code).to.equal(200); });",
						"pm.test('Has token and LECTURER role', function () { var j = pm.response.json(); pm.expect(j).to.have.property('token'); pm.expect(j.roles).to.include('LECTURER'); pm.collectionVariables.set('lecturerToken', j.token); pm.collectionVariables.set('authToken', j.token); if (j.userId) pm.collectionVariables.set('testUserId', j.userId); });"
					]}}],
					"request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"email\": \"\",\n  \"password\": \"\"\n}" },
