			"name": "Auth",
			"item": [
				{
					"name": "Login - Admin",
					"event": [{ "listen": "test", "script": { "exec": [
						"pm.test('Status is 200', function () { pm.expect(pm.response.code).to.equal(200); });",
						"pm.test('Has token and ADMIN role', function () { var j = pm.response.json(); pm.expect(j).to.have.property('token'); pm.expect(j.roles).to.include('ADMIN'); pm.collectionVariables.set('adminToken', j.token); pm.collectionVariables.set('authToken', j.token); if (j.userId) pm.collectionVariables.set('testUserId', j.userId); });"
					]}}],
					"request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"email\": \"\",\n  \"password\": \"\"\n}" },
						"url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
					}
				},
				{
					"name": "Register - Student",
					"event": [{ "listen": "test", "script": { "exec": [
						"pm.test('Status is 201', function () { pm.expect(pm.response.code).to.equal(201); });",
						"pm.test('Has token and STUDENT role', function () { var j = pm.response.json(); pm.expect(j).to.have.property('token'); pm.expect(j.roles).to.include('STUDENT'); pm.collectionVariables.set('studentToken', j.token); pm.collectionVariables.set('authToken', j.token); if (j.userId) pm.collectionVariables.set('testUserId', j.userId); });"
					]}}],
					"request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"firstName\": \"\",\n  \"lastName\": \"\",\n  \"email\": \"\",\n  \"password\": \"\"\n}" },
						"url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
					}
				},
